{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/iic-study-app-replit",
    "artifacts/api-server",
    "artifacts/mockup-sandbox",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "vite artifacts/iic-study-app-replit --config artifacts/iic-study-app-replit/vite.config.ts --host 0.0.0.0 --port 3000",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build artifacts/iic-study-app-replit --config artifacts/iic-study-app-replit/vite.config.ts && node scripts/sync-dist.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && tsc -p artifacts/iic-study-app-replit/tsconfig.json --noEmit",
    "lint": "tsc --build"
  },
  "devDependencies": {
    "katex": "^0.16.22",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "jsqr": "^1.4.0"
  }
}
